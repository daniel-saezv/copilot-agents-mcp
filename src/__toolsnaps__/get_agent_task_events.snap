{
  "name": "get_agent_task_events",
  "title": "Get task events",
  "description": "[Experimental] Undocumented internal GitHub endpoint that can change without notice. Read one page of task events (read-only).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string",
        "description": "Task identifier."
      },
      "page": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "description": "Page, starting at 1."
      },
      "per_page": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "description": "Events per page."
      }
    },
    "required": [
      "task_id",
      "page",
      "per_page"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string"
      },
      "page": {
        "type": "number"
      },
      "per_page": {
        "type": "number"
      },
      "total": {
        "type": "number"
      },
      "events": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "timestamp": {
              "type": "string"
            },
            "parentId": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "data": {}
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "task_id",
      "page",
      "per_page",
      "total",
      "events"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "annotations": {
    "title": "Get task events",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "execution": {
    "taskSupport": "forbidden"
  }
}
