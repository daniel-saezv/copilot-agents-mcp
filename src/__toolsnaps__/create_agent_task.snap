{
  "name": "create_agent_task",
  "title": "Launch Copilot task",
  "description": "Launch a GitHub Copilot cloud agent with repo, prompt, and model; use list_copilot_models to discover IDs. Returns status, delivery, follow_up, and next_step. May fail for authentication, repository access or policy, invalid input, or an unavailable model; previously rejected models skip the API and list accepted models observed so far. Returns immediately with task_id. Follow next_step. If setup is present, ask once and record the answer with set_completion_strategy.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "repo": {
        "type": "string",
        "description": "Required repository in owner/name form, e.g. octocat/hello-world; surrounding whitespace is trimmed."
      },
      "prompt": {
        "type": "string",
        "description": "Required non-blank task instructions; surrounding whitespace is trimmed. Never include credentials."
      },
      "model": {
        "type": "string",
        "description": "Required non-blank model ID, e.g. gpt-6.1-sol; trimmed and sent unchanged without a closed allowlist. Discover IDs with list_copilot_models."
      },
      "base_ref": {
        "description": "Base branch for a new branch or pull request, e.g. main. Omit to use GitHub's default.",
        "type": "string"
      },
      "head_ref": {
        "description": "Existing branch. With base_ref, the agent commits to this branch. Omit to let GitHub choose.",
        "type": "string"
      },
      "custom_agent": {
        "description": "Custom agent name without the extension. Omit to use GitHub's default agent.",
        "type": "string"
      },
      "create_pull_request": {
        "description": "When true, the API creates a pull request. Omit to use GitHub's default.",
        "type": "boolean"
      },
      "owner_token": {
        "description": "Private owner token issued by local webhook register. Omit for unowned tasks; never paste tokens into chat.",
        "type": "string"
      }
    },
    "required": [
      "repo",
      "prompt",
      "model"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string"
      },
      "repo": {
        "type": "string"
      },
      "owner": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "working",
          "needs_input",
          "completed",
          "failed",
          "cancelled"
        ]
      },
      "terminal": {
        "type": "boolean"
      },
      "requested_model": {
        "type": "string"
      },
      "delivery": {
        "type": "string",
        "enum": [
          "not_configured",
          "pending",
          "delivered",
          "failed"
        ]
      },
      "session_url": {
        "type": "string"
      },
      "pr_url": {
        "type": "string"
      },
      "follow_up": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "push",
              "check_later"
            ],
            "description": "Wake on a webhook, or end the turn and schedule a later check."
          },
          "channels": {
            "description": "Configured notification channels, when available.",
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "webhook"
              ]
            }
          },
          "check_after": {
            "type": "string",
            "description": "ISO 8601 timestamp; do not check before this time."
          },
          "min_interval_s": {
            "type": "number",
            "description": "Minimum seconds between subsequent checks."
          },
          "check_with": {
            "type": "string",
            "const": "list_agent_tasks",
            "description": "Tool to call for a scheduled check."
          }
        },
        "required": [
          "mode",
          "check_after",
          "min_interval_s",
          "check_with"
        ],
        "additionalProperties": false
      },
      "next_step": {
        "type": "string"
      },
      "setup": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "required"
          },
          "question_intent": {
            "type": "string"
          },
          "record_with": {
            "type": "string",
            "const": "set_completion_strategy"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "enum": [
                    "webhook",
                    "check_later"
                  ]
                },
                "intent": {
                  "type": "string"
                },
                "recommended": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "intent"
              ],
              "additionalProperties": false
            }
          },
          "ask_instruction": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "question_intent",
          "record_with",
          "options",
          "ask_instruction"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "task_id",
      "repo",
      "status",
      "terminal",
      "requested_model",
      "delivery",
      "follow_up",
      "next_step"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "annotations": {
    "title": "Launch Copilot task",
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true
  },
  "execution": {
    "taskSupport": "forbidden"
  }
}
