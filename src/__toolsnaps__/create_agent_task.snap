{
  "name": "create_agent_task",
  "title": "Launch Copilot task",
  "description": "Launch a GitHub Copilot cloud agent task. The model is sent unchanged. If the model was already rejected, the tool skips the API call and lists accepted models observed so far. Returns immediately with task_id. The task keeps running in the cloud for minutes; the task_id stays valid while GitHub keeps the task. Follow next_step.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "repo": {
        "type": "string",
        "description": "Repository in owner/name form."
      },
      "prompt": {
        "type": "string",
        "description": "Instructions for the agent."
      },
      "model": {
        "type": "string",
        "description": "Model sent unchanged to the API without a closed allowlist."
      },
      "base_ref": {
        "description": "Base branch for a new branch or pull request.",
        "type": "string"
      },
      "head_ref": {
        "description": "Existing branch. With base_ref, the agent commits to this branch.",
        "type": "string"
      },
      "custom_agent": {
        "description": "Custom agent name without the extension.",
        "type": "string"
      },
      "create_pull_request": {
        "description": "When true, the API creates a pull request.",
        "type": "boolean"
      },
      "owner": {
        "description": "Stable name of the agent or bot launching the task (e.g. your own name). Several agents may share this server; pass the same owner every time and filter list_agent_tasks by it.",
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9._-]+$"
      }
    },
    "required": [
      "repo",
      "prompt",
      "model"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string"
      },
      "repo": {
        "type": "string"
      },
      "owner": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "working",
          "needs_input",
          "completed",
          "failed",
          "cancelled"
        ]
      },
      "terminal": {
        "type": "boolean"
      },
      "requested_model": {
        "type": "string"
      },
      "html_url": {
        "type": "string"
      },
      "follow_up": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "push",
              "user_push",
              "check_later"
            ]
          },
          "channels": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "webhook",
                "system"
              ]
            }
          },
          "check_after": {
            "type": "string"
          },
          "min_interval_s": {
            "type": "number"
          },
          "check_with": {
            "type": "string",
            "const": "list_agent_tasks"
          }
        },
        "required": [
          "mode",
          "check_after",
          "min_interval_s",
          "check_with"
        ],
        "additionalProperties": false
      },
      "next_step": {
        "type": "string"
      }
    },
    "required": [
      "task_id",
      "repo",
      "status",
      "terminal",
      "requested_model",
      "follow_up",
      "next_step"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "annotations": {
    "title": "Launch Copilot task",
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true
  },
  "execution": {
    "taskSupport": "forbidden"
  }
}
