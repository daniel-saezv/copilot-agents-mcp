{
  "name": "create_agent_task",
  "title": "Launch Copilot task",
  "description": "Launch a GitHub Copilot cloud agent task. The model is sent unchanged. If the model was already rejected, the tool skips the API call and lists accepted models observed so far. Returns immediately; do not poll in a loop—end your turn and wait for notification.channels or a user prompt before calling get_agent_task.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "repo": {
        "type": "string",
        "description": "Repository in owner/name form."
      },
      "prompt": {
        "type": "string",
        "description": "Instructions for the agent."
      },
      "model": {
        "type": "string",
        "description": "Model sent unchanged to the API without a closed allowlist."
      },
      "base_ref": {
        "description": "Base branch for a new branch or pull request.",
        "type": "string"
      },
      "head_ref": {
        "description": "Existing branch. With base_ref, the agent commits to this branch.",
        "type": "string"
      },
      "custom_agent": {
        "description": "Custom agent name without the extension.",
        "type": "string"
      },
      "create_pull_request": {
        "description": "When true, the API creates a pull request.",
        "type": "boolean"
      }
    },
    "required": [
      "repo",
      "prompt",
      "model"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string"
      },
      "repo": {
        "type": "string"
      },
      "state": {
        "type": "string"
      },
      "requested_model": {
        "type": "string"
      },
      "created_at": {
        "type": [
          "string",
          "null"
        ]
      },
      "html_url": {
        "type": [
          "string",
          "null"
        ]
      },
      "notification": {
        "type": "object",
        "properties": {
          "channels": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "system",
                "webhook"
              ]
            }
          },
          "watcher_started": {
            "type": "boolean"
          }
        },
        "required": [
          "channels",
          "watcher_started"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "task_id",
      "repo",
      "state",
      "requested_model",
      "created_at",
      "html_url",
      "notification"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "annotations": {
    "title": "Launch Copilot task",
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true
  },
  "execution": {
    "taskSupport": "forbidden"
  }
}
