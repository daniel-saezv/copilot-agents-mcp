{
  "name": "abort_agent_task",
  "title": "Abort task",
  "description": "[Experimental] Undocumented internal GitHub endpoint that can change without notice. Send {type: \"abort\"} to the steer endpoint, as VS Code does in tasksClient.ts, to stop the task. This has not been verified against GitHub.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string",
        "description": "Task identifier."
      }
    },
    "required": [
      "task_id"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string"
      },
      "accepted": {
        "type": "boolean"
      },
      "reason": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "working",
          "needs_input",
          "completed",
          "failed",
          "cancelled"
        ]
      },
      "terminal": {
        "type": "boolean"
      }
    },
    "required": [
      "task_id",
      "accepted"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "annotations": {
    "title": "Abort task",
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "execution": {
    "taskSupport": "forbidden"
  }
}
