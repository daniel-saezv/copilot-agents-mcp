{
  "name": "abort_agent_task",
  "title": "Abortar una tarea",
  "description": "[Experimental] Endpoint interno no documentado de GitHub que puede cambiar sin aviso. Envía {type: \"abort\"} al endpoint de steer, como hace VS Code (tasksClient.ts), para detener la tarea. No se ha probado contra GitHub.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string",
        "description": "Identificador de la tarea."
      }
    },
    "required": [
      "task_id"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string"
      },
      "accepted": {
        "type": "boolean"
      }
    },
    "required": [
      "task_id",
      "accepted"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "annotations": {
    "title": "Abortar una tarea",
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true
  },
  "execution": {
    "taskSupport": "forbidden"
  }
}
