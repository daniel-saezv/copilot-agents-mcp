{
  "name": "abort_agent_task",
  "title": "Abort task",
  "description": "[Experimental] Undocumented internal GitHub endpoint that can change without notice. Request cancellation of task_id via the internal steer endpoint; not verified against live GitHub. Owned tasks require their matching owner_token. Use only to stop work, not to read status. Returns accepted, status, and terminal; accepted=false with reason when already finished. Acceptance does not mean cancellation has completed. Check authentication and task access on errors.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string",
        "description": "Required non-blank task identifier returned by create_agent_task."
      },
      "owner_token": {
        "description": "Private owner token issued by local webhook register. Omit for unowned tasks; never paste tokens into chat.",
        "type": "string"
      }
    },
    "required": [
      "task_id"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string"
      },
      "accepted": {
        "type": "boolean"
      },
      "reason": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "working",
          "needs_input",
          "completed",
          "failed",
          "cancelled"
        ]
      },
      "terminal": {
        "type": "boolean"
      }
    },
    "required": [
      "task_id",
      "accepted"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "annotations": {
    "title": "Abort task",
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "execution": {
    "taskSupport": "forbidden"
  }
}
