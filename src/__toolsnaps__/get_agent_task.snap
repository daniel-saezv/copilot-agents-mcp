{
  "name": "get_agent_task",
  "title": "Get task status",
  "description": "Read one task once. Returns status, terminal and a one-line summary. Do not call repeatedly; use list_agent_tasks for periodic checks.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string",
        "description": "Task identifier."
      },
      "repo": {
        "description": "Repository in owner/name form. If omitted, use the saved repository or user endpoint.",
        "type": "string"
      },
      "verbose": {
        "description": "Include raw state, models, usage, and full error.",
        "type": "boolean"
      }
    },
    "required": [
      "task_id"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "annotations": {
    "title": "Get task status",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "execution": {
    "taskSupport": "forbidden"
  }
}
