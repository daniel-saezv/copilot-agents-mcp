{
  "name": "get_agent_task",
  "title": "Get task status",
  "description": "Read a GitHub Copilot agent task once.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string",
        "description": "Task identifier."
      },
      "repo": {
        "description": "Repository in owner/name form. If omitted, use the saved repository or user endpoint.",
        "type": "string"
      }
    },
    "required": [
      "task_id"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string"
      },
      "repo": {
        "type": "string"
      },
      "state": {
        "type": "string"
      },
      "requested_model": {
        "type": [
          "string",
          "null"
        ]
      },
      "resolved_model": {
        "description": "sessions[].model exactly as returned by the API.",
        "type": [
          "string",
          "null"
        ]
      },
      "pull_request": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "number",
                "description": "Internal API ID, not the pull request number."
              },
              "number": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "html_url": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "number",
              "html_url"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "branch": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "head_ref": {
                "type": "string"
              },
              "base_ref": {
                "type": "string"
              }
            },
            "required": [
              "head_ref",
              "base_ref"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "artifacts": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "pull"
                },
                "id": {
                  "type": "number"
                }
              },
              "required": [
                "type",
                "id"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "branch"
                },
                "head_ref": {
                  "type": "string"
                },
                "base_ref": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "head_ref",
                "base_ref"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "error": {
        "type": [
          "string",
          "null"
        ]
      },
      "usage": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "ai_credits",
                  "premium_requests"
                ]
              },
              "amount": {
                "type": "number",
                "description": "Raw value from the API. ai_credits uses nano-units."
              },
              "amount_human": {
                "type": "number",
                "description": "ai_credits divided by 1e9. premium_requests is unchanged."
              }
            },
            "required": [
              "type",
              "amount",
              "amount_human"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "created_at": {
        "type": [
          "string",
          "null"
        ]
      },
      "updated_at": {
        "type": [
          "string",
          "null"
        ]
      },
      "completed_at": {
        "type": [
          "string",
          "null"
        ]
      },
      "session_id": {
        "description": "ID of the task's latest session.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "task_id",
      "repo",
      "state",
      "requested_model",
      "resolved_model",
      "pull_request",
      "branch",
      "artifacts",
      "error",
      "usage",
      "created_at",
      "updated_at",
      "completed_at",
      "session_id"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "annotations": {
    "title": "Get task status",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "execution": {
    "taskSupport": "forbidden"
  }
}
