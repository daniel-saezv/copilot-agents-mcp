{
  "name": "steer_agent_task",
  "title": "Steer task",
  "description": "[Experimental] Undocumented internal GitHub endpoint that can change without notice. Each steer consumes credits. The agent applies the instruction after its current tool call finishes. Send an instruction to a task with an open pull request.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string",
        "description": "Task identifier."
      },
      "content": {
        "type": "string",
        "description": "Instructions to send to the task."
      }
    },
    "required": [
      "task_id",
      "content"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string"
      },
      "accepted": {
        "type": "boolean"
      },
      "session_count": {
        "type": "number"
      }
    },
    "required": [
      "task_id",
      "accepted",
      "session_count"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "annotations": {
    "title": "Steer task",
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true
  },
  "execution": {
    "taskSupport": "forbidden"
  }
}
