{
  "name": "steer_agent_task",
  "title": "Redirigir una tarea",
  "description": "[Experimental] Endpoints internos no documentados de GitHub que pueden cambiar sin aviso. Cada steer consume créditos. El agente aplica la instrucción después de terminar la herramienta que esté ejecutando. Envía una instrucción a una tarea con pull request abierta.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string",
        "description": "Identificador de la tarea."
      },
      "content": {
        "type": "string",
        "description": "Instrucción que se envía a la tarea."
      }
    },
    "required": [
      "task_id",
      "content"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string"
      },
      "accepted": {
        "type": "boolean"
      },
      "session_count": {
        "type": "number"
      }
    },
    "required": [
      "task_id",
      "accepted",
      "session_count"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "annotations": {
    "title": "Redirigir una tarea",
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true
  },
  "execution": {
    "taskSupport": "forbidden"
  }
}
