#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

# --- stack (setup-proyecto) ---
install_stack() {
  if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
    echo "scripts/setup: hace falta Node.js 22.18 o posterior y npm." >&2
    exit 1
  fi
  node -e 'const [major, minor] = process.versions.node.split(".").map(Number); if (major < 22 || (major === 22 && minor < 18)) { console.error("scripts/setup: hace falta Node.js 22.18 o posterior. Hay " + process.versions.node); process.exit(1); }'
  npm ci
}
# --- fin stack ---

install_stack
