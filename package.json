{
  "name": "copilot-agents-mcp",
  "version": "0.1.0",
  "description": "Servidor MCP local para lanzar agentes de GitHub Copilot en la nube.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "copilot-agents-mcp": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniel-saezv/copilot-agents-mcp.git"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/cli.js',0o755)\"",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "licenses": "node scripts/check-licenses.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^5.1.1"
  }
}
